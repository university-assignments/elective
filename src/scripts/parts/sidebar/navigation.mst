
<li class="mb-1">
	<button
		class="btn btn-toggle align-items-center rounded"
		data-bs-toggle="collapse"
		data-bs-target="#{{ show_identifier }}"
		aria-expanded="false"
	>
		{{ title }}
	</button>

	<div id="{{ show_identifier }}" class="collapse">
		<ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
			{{ #categories }}
				<li class="category">
					<a class="link-dark rounded">{{ category }}</a>
				</li>
			{{ /categories }}
		</ul>
	</div>
</li>
